<resources>
    <style name="Theme.PD" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:colorAccent">@color/ic_bg</item>
        <item name="android:colorControlActivated">@color/ic_bg</item>
    </style>
    <color name="bg">#FFFFFFFF</color>
    <color name="ic_bg">#FF111111</color>
    <color name="launcher_bg">#FF212121</color>
</resources>
